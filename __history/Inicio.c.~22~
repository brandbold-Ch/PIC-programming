#include <16f877a.h>

#define _XTAL_FREQ 20000000
#include "esp8266.h"
#fuses XT, NOWDT, NOPUT, NOLVP, NOPROTECT, BROWNOUT
#use delay(clock=4M)
#use fast_io(B)

void main() {
   //set_tris_b(0b00000000);
   
   set_tris_b(0x00);
   output_b(0x00);
   
   while(true) {
      output_bit(PIN_B0, 1);
      delay_ms(100);
      output_bit(PIN_B0, 0);
      delay_ms(100);
   }
}
